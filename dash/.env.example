# Copie pra .env e preencha. .env nunca é commitado (ver .gitignore).
# Mesmas credenciais já usadas em transform/profiles.yml, nos conectores e
# no antigo app Streamlit — só pra leitura do Parquet em gold/.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# Basic Auth (usuário/senha pedidos pelo navegador antes de abrir o app).
# Opcional: deixe as duas em branco pra abrir sem login (útil em dev local).
# Em produção (Railway, Fly.io etc. sem auth nativa), preencha as duas.
DASH_AUTH_USERNAME=
DASH_AUTH_PASSWORD=
